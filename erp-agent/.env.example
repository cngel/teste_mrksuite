# Copia este ficheiro para .env e ajusta se necessário
# (o projeto não carrega .env automaticamente por defeito — usa
# `export $(cat .env | xargs)` ou a tua ferramenta preferida, ex. python-dotenv)

# Qual backend de LLM usar: ollama (local, por omissão) | groq | gemini | anthropic
MODEL_PROVIDER=ollama
AGENT_LANGUAGE=pt

# Ollama (local, via API compatível com OpenAI)
OLLAMA_BASE_URL=http://localhost:11434/v1
MODEL_NAME=gemma4:e4b

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Gemini (Google) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-opus-4-8

# URL do web-service (proxy /api/... com a camada de permissões por módulo)
WEB_SERVICE_URL=http://localhost:5002
AGENT_HTTP_TIMEOUT=15

# Automações (tarefas agendadas) — ver app/tasks_store.py e app/task_runner.py
TASKS_DB_PATH=data/tasks.db
TASKS_POLL_INTERVAL=30
