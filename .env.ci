# Valores fictícios, só para o stack de validação de CI (docker-compose.ci.yml).
# Nunca usar estes valores em desenvolvimento real ou produção — é seguro
# commitar este ficheiro porque não protege nada real, existe só para o
# stack efémero subir e os serviços arrancarem sem erro.

POSTGRES_DB=ci_db
POSTGRES_USER=ci_user
POSTGRES_PASSWORD=ci_password

MINIO_ROOT_USER=ci_minio_user
MINIO_ROOT_PASSWORD=ci_minio_password
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio:9000

JWT_SECRET=ci_only_jwt_secret_not_for_prod
PASSWORD_PEPPER=ci_only_pepper_not_for_prod
