# Copia para .env (nunca commitado — ver .gitignore) e preenche com
# valores reais antes de correr `docker compose up`.
#
# Para CI/validação automática usa-se .env.ci (valores fictícios, dedicado
# só a essa finalidade — ver docker-compose.ci.yml e o Makefile).

POSTGRES_DB=crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=

# WhatsApp Cloud API (webhook app.js)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_INTERNAL_SECURE=false

# MINIO_PUBLIC_ENDPOINT é o host colocado nos URLs pré-assinados que o
# BROWSER do utilizador final segue diretamente — em produção tem de ser o
# domínio público (ex: marksuite.ao), nunca "localhost" (isso resolveria
# para a máquina do próprio utilizador, não para o servidor). É preciso
# também expor o MinIO publicamente através de um location no Nginx que
# faça proxy_pass para 127.0.0.1:9000, já que o docker-compose só publica
# a porta 9000 em 127.0.0.1.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

JWT_SECRET=
PASSWORD_PEPPER=
